+[gcode_macro SELECT_TOOL]
+rename_existing: _SELECT_TOOL_BASE
+gcode:
+  {% set t = params.T|int %}
+  _SELECT_TOOL_BASE T={t}
+
+  # Give the toolchanger a moment to settle
+  G4 P200
+
+  # Always load shapers (including T0)
+  TC_LOAD_SHAPERS T={t}
+
+  # Never auto-apply T0 probe/nozzle offsets
+  {% if t|int != 0 %}
+    _TC_UPDATE_OFFSETS LOAD_ALL=1
+    _TC_UPDATE_TOOL_PROBE_Z_OFFSETS LOAD_ALL=1
+  {% endif %}
+
