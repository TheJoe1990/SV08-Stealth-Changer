+
+# SLICER_COMPAT_ALIAS (2026-10-03) ------------------------------------------------
+#  Slicer profiles call either START_PRINT or PRINT_START. Klipper treats an
+#  unknown one as "Unknown command" and keeps printing, silently skipping the
+#  whole start sequence. These aliases forward to this printer's real entry
+#  (START_PRINT). With no temps passed (stock slicer line), BED_TEMP/EXTRUDER_TEMP
+#  come from the current heater targets. Internal calls (TICK/SKIP/...) use
+#  the real entry name and never come through here.
+
+[gcode_macro PRINT_START]
+description: Slicer-compat alias for START_PRINT
+gcode:
+    {% set extra = "" %}
+    {% set internal = params.TICK is defined or params.SKIP is defined or params.CANCEL is defined or params.HEATUP_TICK is defined %}
+    {% if not internal %}
+        {% if params.BED is not defined and params.BED_TEMP is not defined and printer.heater_bed.target|float > 0 %}
+            {% set extra = extra ~ " BED_TEMP=" ~ printer.heater_bed.target|int %}
+        {% endif %}
+        {% if params.EXTRUDER is not defined and params.EXTRUDER_TEMP is not defined and params.TOOL_TEMP is not defined and printer.extruder.target|float > 0 %}
+            {% set extra = extra ~ " EXTRUDER_TEMP=" ~ printer.extruder.target|int %}
+        {% endif %}
+    {% endif %}
+    {action_respond_info("PRINT_START -> START_PRINT " ~ rawparams ~ extra)}
+    START_PRINT {rawparams}{extra}
