+[gcode_macro _TC_WAIT_MARK]
+description: 2026-10-12 -- how long a tool change waits at the prime tower for the nozzle to heat (printing only).
+  STAGE=reset (start of print) | start / end (around the pickup temperature wait) | summary (END_PRINT)
+variable_start: 0.0
+variable_buffered: 0.0
+variable_start_temp: 0.0
+variable_per_tool: {}
+gcode:
+    {% set stage = params.STAGE|default('end')|lower %}
+    {% set ext = params.EXTRUDER|default('') %}
+    {% set now = printer.print_stats.total_duration|float %}
+    {% if stage == 'reset' %}
+        SET_GCODE_VARIABLE MACRO=_TC_WAIT_MARK VARIABLE=per_tool VALUE="{ {} }"
+        SET_GCODE_VARIABLE MACRO=_TC_STATS VARIABLE=print_changes VALUE=0
+    {% elif stage == 'start' %}
+        # motion still queued when the wait starts would have happened anyway -> not counted as waiting
+        {% set th = printer.toolhead %}
+        SET_GCODE_VARIABLE MACRO=_TC_WAIT_MARK VARIABLE=start VALUE={now}
+        SET_GCODE_VARIABLE MACRO=_TC_WAIT_MARK VARIABLE=buffered VALUE={[th.print_time|float - th.estimated_print_time|float, 0.0]|max}
+        SET_GCODE_VARIABLE MACRO=_TC_WAIT_MARK VARIABLE=start_temp VALUE={printer[ext].temperature|float if ext in printer else 0.0}
+    {% elif stage == 'end' and printer.print_stats.state == 'printing' %}
+        # 2026-10-12 (user): report any real stall, even under 1 s (time beyond the motion that was still
+        # finishing, to 0.1 s). No line when the tool caught up during the move.
+        {% set waited = [now - start - buffered, 0.0]|max %}
+        {% set key = 'T' ~ params.T|default('?') %}
+        {% set rec = per_tool[key]|default([0, 0, 0.0]) %}
+        {% set did_wait = waited >= 0.05 %}
+        {% set pt = dict(per_tool) %}
+        {% set _ = pt.update({key: [rec[0] + 1, rec[1] + (1 if did_wait else 0), ((rec[2] + (waited if did_wait else 0.0))|float)|round(2)]}) %}
+        SET_GCODE_VARIABLE MACRO=_TC_WAIT_MARK VARIABLE=per_tool VALUE="{pt}"
+        {% if did_wait %}
+            { action_respond_info("%s waited %.1f s at the prime tower to reach temp (%.0f -> %.0f C)"
+                % (key, waited, start_temp, params.TARGET|default(0)|float)) }
+        {% endif %}
+    {% elif stage == 'summary' %}
+        # averages only (for tuning ooze prevention / standby temp): average wait when a tool DID wait
+        {% set lines = [] %}
+        {% for key in per_tool|sort %}
+            {% set rec = per_tool[key] %}
+            {% if rec[1] > 0 %}
+                {% set _ = lines.append("%s: avg wait %.1f s (waited on %d of %d changes)" % (key, rec[2] / rec[1], rec[1], rec[0])) %}
+            {% else %}
+                {% set _ = lines.append("%s: never waited (%d changes)" % (key, rec[0])) %}
+            {% endif %}
+        {% endfor %}
+        {% if lines %}
+            { action_respond_info("Tool-change heat waits this print:\n" ~ lines|join("\n")) }
+        {% endif %}
+    {% endif %}
+
+
+[gcode_macro _TC_STATS]
+description: 2026-10-12 -- tool change success counters (like Trad Rack). RESULT=ok|fail T=n (from
+  _STOP_IF_INCORRECT_TOOL), ACTION=save|show. Kept in memory; saved to variables.cfg (tc_stats) at
+  print end / cancel and right away on a failure, so variables.cfg is not rewritten every tool change.
+variable_stats: None
+variable_print_changes: 0
+gcode:
+    {% set saved = printer.save_variables.variables.tc_stats|default({}) %}
+    {% set st = dict(stats if stats is not none else saved) %}
+    {% set tools = dict(st.get('tools', {})) %}
+    {% set key = 'T' ~ params.T|default('?') %}
+    {% set res = params.RESULT|default('')|lower %}
+    {% set act = params.ACTION|default('')|lower %}
+    {% if res in ['ok', 'fail'] %}
+        {% set rec = tools.get(key, [0, 0]) %}
+        {% set prev = st.get('since_fail', 0) %}
+        {% if res == 'ok' %}
+            {% set _ = tools.update({key: [rec[0] + 1, rec[1]]}) %}
+            {% set _ = st.update({'ok': st.get('ok', 0) + 1, 'since_fail': prev + 1, 'best_streak': [st.get('best_streak', 0), prev + 1]|max}) %}
+        {% else %}
+            {% set _ = tools.update({key: [rec[0], rec[1] + 1]}) %}
+            {% set _ = st.update({'fail': st.get('fail', 0) + 1, 'since_fail': 0, 'last_fail': key}) %}
+        {% endif %}
+        {% set _ = st.update({'tools': tools}) %}
+        SET_GCODE_VARIABLE MACRO=_TC_STATS VARIABLE=stats VALUE="{st}"
+        SET_GCODE_VARIABLE MACRO=_TC_STATS VARIABLE=print_changes VALUE={print_changes + 1}
+        {% if res == 'fail' %}
+            SAVE_VARIABLE VARIABLE=tc_stats VALUE="{st}"
+            { action_respond_info("Tool change FAILED on %s -- streak reset after %d successful changes (%d failures overall)" % (key, prev, st['fail'])) }
+        {% endif %}
+    {% elif act == 'save' %}
+        {% if stats is not none %}
+            SAVE_VARIABLE VARIABLE=tc_stats VALUE="{st}"
+        {% endif %}
+    {% elif act == 'show' %}
+        {% set per = [] %}
+        {% for k in tools|sort %}
+            {% set _ = per.append("%s %d ok / %d failed" % (k, tools[k][0], tools[k][1])) %}
+        {% endfor %}
+        { action_respond_info("Tool changes: %d total (%d failed) | %d since the last failure%s | best streak %d | this print %d\n%s"
+            % (st.get('ok', 0) + st.get('fail', 0), st.get('fail', 0), st.get('since_fail', 0),
+               (" (" ~ st['last_fail'] ~ ")") if 'last_fail' in st else "", st.get('best_streak', 0), print_changes,
+               per|join(", ") if per else "no tool changes counted yet")) }
+    {% endif %}
+
+
+[gcode_macro TC_STATS]
+description: Show tool change counters (total, failures, since the last failure, per tool)
+gcode:
+    _TC_STATS ACTION=show
