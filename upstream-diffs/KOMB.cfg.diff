+variable_old_vel: 0
+variable_old_accel: 0
+variable_old_scv: 0
 gcode:
     SAVE_GCODE_STATE NAME=clean_nozzle_state
+
+    {% set vars = printer["gcode_macro _KOMB_Variables"] %}
+
+    # Figure out which heater belongs to the currently active tool
+    {% if 'toolchanger' in printer %}
+        {% set tc  = printer.toolchanger %}
+        {% set atn = tc.tool_number|int %}
+        {% if atn >= 0 and atn < tc.tool_names|length %}
+            {% set tool_name = tc.tool_names[atn] %}
+            {% set tool_obj  = printer[tool_name] %}
+            {% set heater    = tool_obj.extruder %}
+        {% else %}
+            {% set heater = 'extruder' %}
+        {% endif %}
+    {% else %}
+        {% set heater = 'extruder' %}
+    {% endif %}
+
+    # Optional soft limit on motion while brushing
+    {% set komb_max_vel  = vars.max_velocity|float %}
+    {% set komb_max_acc  = vars.max_accel|float %}
+    {% set komb_max_scv  = vars.max_scv|float %}
+
+    {% if komb_max_vel > 0 %}
+        {% set cur_vel  = printer.toolhead.max_velocity|float %}
+        {% set cur_acc  = printer.toolhead.max_accel|float %}
+        {% set cur_scv  = printer.toolhead.square_corner_velocity|float %}
+
+        SET_GCODE_VARIABLE MACRO=KOMB VARIABLE=old_vel   VALUE={cur_vel}
+        SET_GCODE_VARIABLE MACRO=KOMB VARIABLE=old_accel VALUE={cur_acc}
+        SET_GCODE_VARIABLE MACRO=KOMB VARIABLE=old_scv   VALUE={cur_scv}
+
+        SET_VELOCITY_LIMIT VELOCITY={komb_max_vel} ACCEL={komb_max_acc} SQUARE_CORNER_VELOCITY={komb_max_scv}
+    {% endif %}
 
