+cs_pin: T2:gpio27
+spi_software_sclk_pin: T2:gpio18
+spi_software_mosi_pin: T2:gpio20
+spi_software_miso_pin: T2:gpio19
+# 2026-10-04: the Nitehawk-36 stands upright in the toolhead, so the ADXL axes
+# are rotated vs the printer. Measured with AXES_MAP_CALIBRATION on T0:
+# X->-x (3.1 deg), Y->-z (5.9 deg), Z->-y (4.6 deg), gravity 10.18 m/s^2.
+# Without this, input shaper Y (and drop-detection tilt) read the wrong axis.
+# _REQUIRE_ADXL_AXES_MAP (tc_shapers.cfg) refuses shaper calibration if missing.
+axes_map: -x, -z, -y
+
+[gcode_macro T2]
+variable_color: ""
+gcode:
+  SELECT_TOOL T=2
+
+[tool_probe T2]
+pin: T2:gpio10
+tool: 2
+# You can find the z_offset option in the printer.cfg
+z_offset : -0.55
+speed: 15.0
+samples: 3
+sample_retract_dist: 2.0
+lift_speed: 10
+samples_result: median
+samples_tolerance: 0.006
+samples_tolerance_retries: 10
+
+activate_gcode:
+    {% set PROBE_TEMP = 150 %}
+    {% set MAX_TEMP = PROBE_TEMP + 5 %}
+    {% set ACTUAL_TEMP = printer.extruder2.temperature %}
+    {% set TARGET_TEMP = printer.extruder2.target %}
+
+    {% if TARGET_TEMP > PROBE_TEMP %}
+        { action_respond_info('Extruder temperature target of %.1fC is too high, lowering to %.1fC' % (TARGET_TEMP, PROBE_TEMP)) }
+        M109 S{ PROBE_TEMP }
+    {% else %}
+        {% if ACTUAL_TEMP > MAX_TEMP %}
+            { action_respond_info('Extruder temperature %.1fC is still too high, waiting until below %.1fC' % (ACTUAL_TEMP, MAX_TEMP)) }
+            TEMPERATURE_WAIT SENSOR=extruder2 MAXIMUM={ MAX_TEMP }
+        {% endif %}
+    {% endif %}
+
+#####################################################################
+#  Orbiter2 Smart Sensor — Tool 2 (T2)
